      m_Calls: []
  m_text: "<size=125%><b><color=#FF2E2E>HIDDEN FOES</color></b></size>\r\n\r\n<size=85%><i><color=#CCCCCC>Blend
    into the crowd. Hunt your rival. Leave no trace.</color></i></size>\r\n\r\n<color=#555555>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\r\n\r\n<size=105%><b><color=#FFFFFF>HOW
    TO PLAY</color></b></size>\r\n\r\n<color=#DDDDDD>\r\nMove naturally through the
    crowd  \r\nNPCs react to suspicious behavior  \r\n\r\nEliminate your rival before
    they eliminate you\r\n</color>\r\n\r\n<size=90%><b><color=#FFFFFF>CONTROLS</color></b></size>\r\n<color=#CCCCCC>\r\nGRAB
    weapons  \r\n\r\n<color=#FF5555>GUN</color>  - Shoot  \r\n<color=#FF8888>KNIFE</color> 
    - Silent attack  \r\n<color=#FFA500>TRAP</color>  - Place and lure  \r\n\r\nHOLD
    to store weapons  \r\nSWAP quickly\r\n</color>\r\n\r\n<size=90%><b><color=#FFFFFF>SYSTEMS</color></b></size>\r\n<color=#CCCCCC>\r\nSuspicion
    increases when seen  \r\n<color=#FF4444>High suspicion exposes you</color>  \r\n\r\nEliminate
    targets to gain points  \r\nStay hidden to survive\r\n</color>\r\n\r\n<color=#555555>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\r\n"
  m_isRightToLeft: 0
